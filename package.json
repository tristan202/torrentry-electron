{
  "name": "torrentry",
  "productName": "Torrentry",
  "version": "2.0.0",
  "description": "Torrentry – a remote control for rTorrent, qBittorrent, Transmission and Deluge",
  "author": "Allan",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:zip": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "dk.torrentry.remote",
    "productName": "Torrentry",
    "files": [
      "*.js",
      "backends/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "electronLanguages": [
      "da",
      "en-US"
    ],
    "compression": "maximum",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@44.10.0": true,
    "electron-winstaller@5.4.0": true
  }
}
